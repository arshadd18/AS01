// 1. Database Connection Configuration
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

//2. User Entity

model User {
  id               Int           @id @default(autoincrement())
  email            String        @unique
  name             String
  password         String
  profilePic       String?
  refreshToken     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relationships
  wallet           Wallet?
  groupMemberships GroupMember[]
  billsPaid        Bill[]
  billSplitsOwed   BillSplit[]
  sentTrans        Transaction[] @relation("Sender")
  receivedTrans    Transaction[] @relation("Receiver")
}

// 3. Wallet Entity (Keeps track of real-time account balances)
model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Decimal prevents rounding bugs. 12 digits total, 2 after the dot (e.g. 9999999999.99)
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
}

// 4. Group Entity
model Group {
  id        Int           @id @default(autoincrement())
  name      String
  createdAt DateTime      @default(now())
  
  // Relationships
  members   GroupMember[]
  bills     Bill[]
}

// 5. GroupMember Entity (Junction table linking Users and Groups)
model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  userId    Int
  createdAt DateTime @default(now())

  // Relationships
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforces that a user cannot join the same group twice
  @@unique([groupId, userId])
}

// 6. Bill Entity (Tracks the total amount spent on a group expense)
model Bill {
  id          Int         @id @default(autoincrement())
  groupId     Int
  paidById    Int
  amount      Decimal     @db.Decimal(12, 2)
  description String
  createdAt   DateTime    @default(now())
  
  // Relationships
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy      User        @relation(fields: [paidById], references: [id])
  splits      BillSplit[]
}

// 7. BillSplit Entity (Tracks exactly how much each individual user owes for a bill)
model BillSplit {
  id        Int      @id @default(autoincrement())
  billId    Int
  userId    Int
  share     Decimal  @db.Decimal(12, 2)
  isPaid    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relationships
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

// 8. Transaction Entity (Your immutable financial passbook ledger)
model Transaction {
  id         Int      @id @default(autoincrement())
  senderId   Int?     // Nullable for account deposits (no sender)
  receiverId Int      // The person getting the money
  amount     Decimal  @db.Decimal(12, 2)
  type       String   // "DEPOSIT", "P2P_TRANSFER", or "GROUP_SETTLEMENT"
  status     String   @default("SUCCESS") // "SUCCESS" or "FAILED"
  createdAt  DateTime @default(now())

  // Relationships
  sender     User?    @relation("Sender", fields: [senderId], references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
}
